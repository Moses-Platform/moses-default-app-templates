{
  "name": "my-app",
  "version": "1.0.0",
  "displayName": "My App",
  "description": "UPDATE THIS — describe what your app does. This text appears in the Moses app registry.",
  "appType": "api",
  "entrypoint": "main.go",
  "templateApiVersion": "moses.ai/v1",
  "embedding": {
    "framing": "denied"
  },
  "apiEndpoints": {
    "basePath": "/api/v1",
    "healthPath": "/health",
    "specPath": "/api/openapi.json"
  },
  "autoRegisterTool": true,
  "displayLocations": ["apps"],
  "permissions": [],
  "platformActions": [
    {
      "id": "emit-ping",
      "label": "Emit ping event",
      "icon": "lucide:radio",
      "description": "Publishes a test event to the app-pings channel so trigger rules can react.",
      "type": "fire_trigger_event",
      "fireTriggerEvent": {
        "channelId": "app-pings",
        "payloadTemplate": {
          "source": "manual",
          "note": "{{note}}"
        }
      },
      "variables": [
        { "name": "note", "type": "string", "required": false, "description": "Free-form note attached to the ping" }
      ],
      "placement": ["chat-quick-action"],
      "availableIn": ["app-standalone", "user-dashboard"],
      "rateLimit": { "perMinute": 10, "perHour": 100 }
    }
  ],
  "platformEvents": [
    {
      "id": "app-pings",
      "name": "Ping events",
      "description": "Sample event channel emitted by the emit-ping action and consumed by the default trigger rule below.",
      "eventSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "note":   { "type": "string" }
        },
        "required": ["source"]
      },
      "retentionDays": 7,
      "sensitivity": "normal"
    }
  ],
  "defaultTriggerRules": [
    {
      "id": "notify-on-ping",
      "name": "Notify on ping",
      "description": "Sends an in-app notification to the grant approver whenever a ping is published.",
      "source": {
        "type": "app_event_channel",
        "channelId": "app-pings"
      },
      "action": {
        "type": "notify",
        "notify": {
          "recipients": ["grant-approver"],
          "template": "Ping event received on the app-pings channel."
        }
      },
      "cooldownSeconds": 60
    }
  ],
  "docker": {
    "files": [
      {
        "name": "app",
        "dockerfile": "Dockerfile",
        "context": "."
      }
    ]
  },
  "service": {
    "port": 8080,
    "healthCheck": {
      "enabled": true,
      "path": "/health"
    },
    "ingress": {
      "enabled": true
    }
  },
  "resources": {
    "cpu": { "request": "100m", "limit": "500m" },
    "memory": { "request": "128Mi", "limit": "512Mi" }
  },
  "integrations": {
    "required": [
      {
        "type": "moses-platform",
        "key": "tenant-info",
        "scopes": ["tenant:read"]
      }
    ]
  },
  "validation": {
    "enabled": true,
    "commands": [
      { "name": "vet", "run": "go vet ./...", "required": true },
      { "name": "test", "run": "go test ./...", "required": true }
    ]
  },
  "maintenance": {
    "renovate": {
      "enabled": true,
      "schedule": "0 4 * * 1",
      "configPath": "renovate.json",
      "context": "Go HTTP API service. Update Go modules and Docker base images. Check for breaking API changes in major dependency updates."
    },
    "logMonitor": {
      "enabled": true,
      "lookbackMinutes": 15,
      "minErrorCount": 5,
      "context": "Go API with Moses platform integration. Common errors: database connection pool exhaustion, panic recovery middleware catches, HTTP client timeouts to external services, and OpenAPI spec generation failures."
    }
  }
}
