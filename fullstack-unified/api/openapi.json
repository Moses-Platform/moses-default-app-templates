{
  "openapi": "3.0.3",
  "info": {
    "title": "Fullstack Unified API",
    "version": "1.0.0",
    "description": "A single Go binary serving both static frontend and API endpoints."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Canonical API base. MUST stay base-path-free: the platform's workspace-tool proxy prepends MOSES_BASE_PATH itself (CHAT-8qiu0). Paths below are relative to this base — the platform's openapi_parser folds servers[0].url + path into the registered endpoint path."
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Application status",
        "responses": {
          "200": {
            "description": "Status response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "app": { "type": "string" },
                    "version": { "type": "string" },
                    "uptime": { "type": "string" },
                    "moses": {
                      "type": "object",
                      "description": "Echo of Moses request-context headers. tenant_id is intentionally ABSENT (CHAT-w6gt: tenant UUIDs stay out of response bodies, enforced by json:\"-\" + test).",
                      "properties": {
                        "user_id": { "type": "string" },
                        "chart_id": { "type": "string" },
                        "request_id": { "type": "string" }
                      }
                    },
                    "env": {
                      "type": "object",
                      "properties": {
                        "port": { "type": "string" },
                        "base_url": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
