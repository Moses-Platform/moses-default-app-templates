{
  "name": "fullstack-unified",
  "version": "1.0.0",
  "displayName": "Fullstack Unified",
  "description": "A single Go binary serving both static frontend files and API endpoints. One container, one Dockerfile, no nginx — the simplest fullstack pattern for Moses.",
  "appType": "hybrid",
  "entrypoint": "index.html",
  "skills": [
    "skills/usage.md"
  ],
  "displayLocations": ["apps"],
  "permissions": [],
  "apiEndpoints": {
    "basePath": "/api/v1",
    "healthPath": "/health",
    "specPath": "/api/openapi.json"
  },
  "autoRegisterTool": true,
  "helm": {
    "chartPath": "helm"
  },
  "docker": {
    "files": [
      {
        "name": "app",
        "dockerfile": "Dockerfile",
        "context": "."
      }
    ]
  },
  "services": {
    "app": {
      "port": 8080,
      "healthCheck": { "enabled": true, "path": "/health" },
      "ingress": { "enabled": true },
      "resources": {
        "cpu": { "request": "100m", "limit": "200m" },
        "memory": { "request": "128Mi", "limit": "256Mi" }
      }
    }
  },
  "validation": {
    "enabled": true,
    "commands": [
      { "name": "go-vet", "run": "go vet ./...", "required": true },
      { "name": "go-test", "run": "go test ./...", "required": true }
    ]
  },
  "maintenance": {
    "renovate": {
      "enabled": true,
      "schedule": "0 4 * * 1",
      "configPath": "renovate.json",
      "context": "Unified Go binary serving static frontend + API. Frontend is embedded at build time. Update both Go modules and any frontend dependencies in the embedded assets."
    },
    "logMonitor": {
      "enabled": true,
      "lookbackMinutes": 15,
      "minErrorCount": 5,
      "context": "Single Go binary serving frontend files and API endpoints. Common errors: static file serving 404s, API handler panics, and port binding failures."
    }
  }
}
