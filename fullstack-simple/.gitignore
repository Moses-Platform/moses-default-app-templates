# Go build artifacts
# /server (root-only) — match the compiled binary at the module root, NOT
# the `backend/cmd/server/` source dir. An un-anchored `server` silently
# ignores cmd/server/*.go (CHAT-8qiu0 caught main_test.go edits never staged).
/server
*.exe
*.test
*.out

# Dependencies
node_modules/
vendor/

# Build outputs
dist/
build/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
