{
  "name": "fullstack-showcase-instance",
  "version": "1.0.0",
  "displayName": "My Fullstack App",
  "description": "Full-stack Moses app scaffold with a bundled PostgreSQL, tenant-scoped storage helpers, and the base-path/CSP/OpenAPI plumbing pre-wired.",
  "appType": "hybrid",
  "entrypoint": "index.html",
  "templateApiVersion": "moses-manager.eu/v1",
  "embedding": {
    "framing": "moses-only"
  },
  "skills": [
    "skills/usage.md",
    "skills/api-integration.md",
    "skills/secrets-tutorial.md"
  ],
  "displayLocations": [
    "dashboard",
    "apps"
  ],
  "permissions": [],
  "apiEndpoints": {
    "basePath": "/api/v1",
    "healthPath": "/health",
    "specPath": "/api/openapi.json"
  },
  "autoRegisterTool": true,
  "helm": {
    "chartPath": "helm"
  },
  "docker": {
    "files": [
      {
        "name": "frontend",
        "dockerfile": "frontend/Dockerfile",
        "context": "frontend"
      },
      {
        "name": "backend",
        "dockerfile": "backend/Dockerfile",
        "context": "backend"
      }
    ]
  },
  "services": {
    "frontend": {
      "port": 8080,
      "healthCheck": {
        "enabled": true,
        "path": "/health"
      },
      "ingress": {
        "enabled": true
      },
      "resources": {
        "cpu": {
          "request": "100m",
          "limit": "200m"
        },
        "memory": {
          "request": "128Mi",
          "limit": "256Mi"
        }
      }
    },
    "backend": {
      "port": 8080,
      "healthCheck": {
        "enabled": true,
        "path": "/health"
      },
      "resources": {
        "cpu": {
          "request": "100m",
          "limit": "500m"
        },
        "memory": {
          "request": "128Mi",
          "limit": "512Mi"
        }
      }
    }
  },
  "dependencies": {
    "services": [
      "postgresql"
    ],
    "bundledServices": [
      "postgresql"
    ]
  },
  "validation": {
    "enabled": true,
    "commands": [
      {
        "name": "frontend-lint",
        "run": "cd frontend && npm install --include=dev --ignore-scripts && npm run lint",
        "required": true
      },
      {
        "name": "frontend-test",
        "run": "cd frontend && NODE_ENV=test npm test",
        "required": true
      },
      {
        "name": "backend-vet",
        "run": "cd backend && go vet ./...",
        "required": true
      },
      {
        "name": "backend-test",
        "run": "cd backend && go test ./...",
        "required": true
      }
    ]
  },
  "maintenance": {
    "renovate": {
      "enabled": true,
      "schedule": "0 4 * * 1",
      "context": "Showcase app with React frontend, Go backend, and PostgreSQL dependency. Update npm packages, Go modules, Docker images, and Helm chart dependencies."
    },
    "logMonitor": {
      "enabled": true,
      "lookbackMinutes": 15,
      "minErrorCount": 5,
      "context": "Full-stack showcase with PostgreSQL. Common errors: database connection failures, migration errors on startup, frontend API integration issues, and authentication/authorization failures with Moses platform."
    }
  }
}
