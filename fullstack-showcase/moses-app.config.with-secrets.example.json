{
  "name": "fullstack-showcase-instance",
  "version": "1.0.0",
  "displayName": "Moses Platform Showcase",
  "description": "Interactive showcase of Moses platform capabilities including MCP tools, deployment pipelines, authentication, and multi-tenancy",
  "appType": "hybrid",
  "entrypoint": "index.html",
  "templateApiVersion": "moses-manager.eu/v1",
  "embedding": {
    "framing": "moses-only"
  },
  "skills": [
    "skills/usage.md",
    "skills/showcase-overview.md",
    "skills/api-integration.md",
    "skills/secrets-tutorial.md"
  ],
  "secrets": {
    "external": [
      {
        "key": "example-api-key",
        "envVar": "EXAMPLE_API_KEY",
        "description": "Third-party API key — tenant admin supplies the value via the Apps-page shield modal",
        "required": true
      },
      {
        "key": "example-encryption-key",
        "envVar": "EXAMPLE_ENCRYPTION_KEY",
        "description": "App-data encryption key — platform-generated, no admin action needed. Dev and stable each get their own independent value (security-first default). Flip sharedAcrossTracks to true ONLY for an app-issued token that must validate across a dev→stable promotion.",
        "generate": {
          "type": "hex",
          "bytes": 32,
          "sharedAcrossTracks": false
        }
      }
    ]
  },
  "quickActions": [
    {
      "id": "overview",
      "label": "Platform Overview",
      "icon": "layout-dashboard",
      "url": "/",
      "description": "Explore Moses capabilities"
    },
    {
      "id": "mcp-tools",
      "label": "MCP Tools",
      "icon": "wrench",
      "url": "/mcp-tools",
      "description": "MCP tool system explained"
    },
    {
      "id": "api-examples",
      "label": "Live API",
      "icon": "code",
      "url": "/api-examples",
      "description": "Interactive API playground"
    }
  ],
  "displayLocations": [
    "dashboard",
    "apps"
  ],
  "permissions": [],
  "platformActions": [
    {
      "id": "open-overview-chat",
      "label": "Chat with Moses about the showcase",
      "icon": "lucide:sparkles",
      "description": "Opens a fresh Moses Manager conversation seeded with the showcase overview.",
      "type": "chat_prompt",
      "chatPrompt": {
        "conversationTitle": "Moses Platform Showcase",
        "messageTemplate": "Walk me through the Moses capabilities highlighted in the showcase app.",
        "openChatSidebar": true
      },
      "placement": ["app-header-menu", "dashboard-shortcut"],
      "availableIn": ["app-standalone", "user-dashboard"]
    },
    {
      "id": "launch-demo-agent",
      "label": "Launch demo agent",
      "icon": "lucide:bot",
      "description": "Creates a ticket AND starts a Claude Code agent immediately.",
      "type": "launch_agent",
      "launchAgent": {
        "ticketTitle": "[Demo] {{task}}",
        "ticketDescription": "Kicked off from the showcase: {{task}}",
        "preferredAgentType": "claude-code",
        "priority": "normal",
        "autoStart": true
      },
      "variables": [
        { "name": "task", "type": "string", "required": true }
      ],
      "placement": ["app-header-menu"],
      "availableIn": ["app-standalone"],
      "requiredUserPermission": "tickets:create",
      "rateLimit": { "perMinute": 5, "perHour": 60 }
    }
  ],
  "apiEndpoints": {
    "basePath": "/api/v1",
    "healthPath": "/health",
    "specPath": "/api/openapi.json"
  },
  "autoRegisterTool": true,
  "helm": {
    "chartPath": "helm"
  },
  "docker": {
    "files": [
      {
        "name": "frontend",
        "dockerfile": "frontend/Dockerfile",
        "context": "frontend"
      },
      {
        "name": "backend",
        "dockerfile": "backend/Dockerfile",
        "context": "backend"
      }
    ]
  },
  "services": {
    "frontend": {
      "port": 8080,
      "healthCheck": { "enabled": true, "path": "/health" },
      "ingress": { "enabled": true },
      "resources": {
        "cpu": { "request": "100m", "limit": "200m" },
        "memory": { "request": "128Mi", "limit": "256Mi" }
      }
    },
    "backend": {
      "port": 8080,
      "healthCheck": { "enabled": true, "path": "/health" },
      "resources": {
        "cpu": { "request": "100m", "limit": "500m" },
        "memory": { "request": "128Mi", "limit": "512Mi" }
      }
    }
  },
  "dependencies": {
    "services": ["postgresql"],
    "bundledServices": ["postgresql"]
  },
  "integrations": {
    "required": [
      {
        "type": "moses-platform",
        "key": "tenant-users",
        "scopes": ["users:list", "tenant:read"]
      }
    ]
  },
  "validation": {
    "enabled": true,
    "commands": [
      { "name": "frontend-lint", "run": "cd frontend && npm install --include=dev --ignore-scripts && npm run lint", "required": true },
      { "name": "frontend-test", "run": "cd frontend && NODE_ENV=test npm test", "required": true },
      { "name": "backend-vet", "run": "cd backend && go vet ./...", "required": true },
      { "name": "backend-test", "run": "cd backend && go test ./...", "required": true }
    ]
  },
  "maintenance": {
    "renovate": {
      "enabled": true,
      "schedule": "0 4 * * 1",
      "context": "Showcase app with React frontend, Go backend, and PostgreSQL dependency. Update npm packages, Go modules, Docker images, and Helm chart dependencies."
    },
    "logMonitor": {
      "enabled": true,
      "lookbackMinutes": 15,
      "minErrorCount": 5,
      "context": "Full-stack showcase with PostgreSQL. Common errors: database connection failures, migration errors on startup, frontend API integration issues, and authentication/authorization failures with Moses platform."
    }
  }
}
