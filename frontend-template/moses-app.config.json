{
  "name": "frontend-template",
  "version": "1.0.0",
  "displayName": "Frontend Template",
  "description": "A clean React+TypeScript+Vite frontend template for Moses platform apps with correct subpath deployment, SPA routing, and health checks",
  "appType": "frontend",
  "entrypoint": "index.html",
  "quickActions": [
    {
      "id": "launch",
      "label": "Launch App",
      "icon": "rocket",
      "url": "/",
      "description": "Open the frontend template"
    },
    {
      "id": "about",
      "label": "About",
      "icon": "info",
      "url": "/about",
      "description": "Learn about this template"
    }
  ],
  "displayLocations": ["apps"],
  "permissions": [],
  "docker": {
    "files": [
      {
        "name": "app",
        "dockerfile": "Dockerfile",
        "context": "."
      }
    ]
  },
  "service": {
    "port": 8080,
    "healthCheck": {
      "enabled": true,
      "path": "/health"
    },
    "ingress": {
      "enabled": true
    }
  },
  "resources": {
    "cpu": { "request": "100m", "limit": "200m" },
    "memory": { "request": "128Mi", "limit": "256Mi" }
  },
  "validation": {
    "enabled": true,
    "commands": [
      { "name": "lint", "run": "npm install --ignore-scripts && npm run lint", "required": true },
      { "name": "test", "run": "npm test", "required": true }
    ]
  },
  "maintenance": {
    "renovate": {
      "enabled": true,
      "schedule": "0 4 * * 1",
      "configPath": "renovate.json",
      "context": "React+Vite frontend. Group React ecosystem updates. Watch for Vite major version changes that may break the build pipeline."
    },
    "logMonitor": {
      "enabled": true,
      "lookbackMinutes": 15,
      "minErrorCount": 5,
      "context": "Static frontend served by nginx. Common errors: chunk loading failures (stale cache after deploy), CORS issues if API proxy misconfigured, 404s on SPA routes without proper fallback."
    }
  }
}
